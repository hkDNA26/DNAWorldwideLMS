generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  TENDER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum CourseType {
  STANDARD
  SCORM
}

enum ScormVersion {
  SCORM_12
  SCORM_2004
}

enum ScormStatus {
  NOT_ATTEMPTED
  INCOMPLETE
  COMPLETED
  PASSED
  FAILED
  BROWSED
}

enum ContentType {
  TEXT
  VIDEO
  QUIZ
  EXTERNAL
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum ResourceKey {
  DRUG_SEARCH
  ALCOHOL_CALCULATOR
  COLLECTORS
  CLINICS
  VIDEOS
  STREET_DRUG_SEARCH
  INFORMATION_BOOKLET
  NEWSLETTER
  POWERPOINT_TEMPLATE
  CPD_MATERIAL
}

enum PdfCategory {
  INFORMATION_BOOKLET
  NEWSLETTER
  POWERPOINT_TEMPLATE
  CPD_MATERIAL
}

model PdfDocument {
  id           String      @id @default(cuid())
  category     PdfCategory
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String?
  uploadedById String?
  createdAt    DateTime    @default(now())

  @@index([category, createdAt])
}

model VideoResource {
  id           String   @id @default(cuid())
  title        String
  provider     String   @default("vimeo")
  videoId      String
  videoHash    String?
  thumbnailUrl String?
  durationSec  Int?
  sortOrder    Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([sortOrder, createdAt])
}

model Collector {
  id           String   @id @default(cuid())
  name         String
  area         String
  inTraining   Boolean  @default(false)
  employment   String?
  livesOutcode String?
  covers       String?
  capabilities String[]
  avgAppTime   String?
  notes        String?
  photoUrl     String?
  lat          Float?
  lng          Float?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([area])
}

model Clinic {
  id             String   @id @default(cuid())
  name           String
  city           String?
  country        String?
  region         String?
  address        String?
  contactName    String?
  email          String?
  phone          String?
  whatsapp       String?
  photoUrl       String?
  lat            Float?
  lng            Float?
  additionalInfo Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([country])
  @@index([region])
}

model ResourceAccess {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource        ResourceKey
  grantedAt       DateTime    @default(now())
  notifiedAt      DateTime?
  firstAccessedAt DateTime?
  lastReminderAt  DateTime?

  @@unique([userId, resource])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(STAFF)
  organizationId String?
  createdAt      DateTime @default(now())
  lastLoginAt    DateTime?

  organization         Organization?         @relation(fields: [organizationId], references: [id])
  courses             Course[]
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?
  inviteTokens        InviteToken[]
  resourceAccess      ResourceAccess[]
}

// A tender client (e.g. a council) whose TENDER-role users see white-labeled branding
// instead of the DNA Worldwide identity while logged in.
model Organization {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())

  users User[]
}

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model CertificateTemplate {
  id           String   @id @default(cuid())
  instructorId String   @unique
  instructor   User     @relation(fields: [instructorId], references: [id])
  imageUrl     String?
  fields       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Course {
  id           String       @id @default(cuid())
  title        String
  description  String
  coverImage   String?
  estimatedTime String?
  status       CourseStatus @default(DRAFT)
  type         CourseType   @default(STANDARD)
  instructorId String
  instructor   User         @relation(fields: [instructorId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]
  scormPackage ScormPackage?
}

model ScormPackage {
  id               String       @id @default(cuid())
  courseId         String       @unique
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version          ScormVersion
  entryPoint       String
  extractedPath    String
  originalFilename String
  manifestTitle    String?
  uploadedAt       DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Module {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  createdAt  DateTime @default(now())

  lessons    Lesson[]
}

model Lesson {
  id          String      @id @default(cuid())
  moduleId    String
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  orderIndex  Int
  contentType ContentType
  content     String?      // TEXT: rich-text HTML body. EXTERNAL: the iframe launch URL.
  videoUrl        String?
  videoThumbnail  String?
  createdAt       DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  quiz        Quiz?
  progress    LessonProgress[]
}

model Quiz {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int
  createdAt    DateTime @default(now())

  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id           String       @id @default(cuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String
  type         QuestionType
  orderIndex   Int

  answerOptions  AnswerOption[]
  attemptAnswers AttemptAnswer[]
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)

  attemptAnswers AttemptAnswer[]
}

model Enrollment {
  id              String    @id @default(cuid())
  studentId       String
  student         User      @relation(fields: [studentId], references: [id])
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id])
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  notifiedAt      DateTime?
  firstAccessedAt DateTime?
  lastReminderAt  DateTime?

  scormStatus           ScormStatus?
  scormScoreRaw         Float?
  scormScoreMin         Float?
  scormScoreMax         Float?
  scormSuspendData      String?      @db.Text
  scormLocation         String?
  scormSessionUpdatedAt DateTime?

  // Highest checkpoint reached inside an EXTERNAL-content lesson that's internally split
  // into sequential parts (e.g. by quiz boundaries) — the embedded app posts a
  // {type: "checkpoint-complete", checkpoint: n} message at each boundary. 0 = none yet.
  externalCheckpoint Int @default(0)

  lessonProgress LessonProgress[]

  @@unique([studentId, courseId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  score       Float
  passed      Boolean
  submittedAt DateTime @default(now())

  answers     AttemptAnswer[]
}

model AttemptAnswer {
  id             String        @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question      @relation(fields: [questionId], references: [id])
  answerOptionId String?
  answerOption   AnswerOption? @relation(fields: [answerOptionId], references: [id])
  textAnswer     String?
}

model Certificate {
  id               String   @id @default(cuid())
  studentId        String
  student          User     @relation(fields: [studentId], references: [id])
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id])
  issuedAt         DateTime @default(now())
  verificationCode String   @unique @default(cuid())

  @@unique([studentId, courseId])
}
